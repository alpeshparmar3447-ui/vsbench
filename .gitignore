# Environments and build output
.venv
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/

# Large inputs, fetched rather than versioned (LIT-PCBA full_data.tgz, PDB depositions)
data/raw/
data/pdb_cache/
tools/
logs/

# Docking output is tens of gigabytes of poses, grids and work directories, and is
# regenerated by re-running. Only each run's summary tables and figures are versioned.
results/**
!results/*/
!results/*/*.csv
!results/*/*.md
!results/*/*.json
!results/*/figures/
!results/*/figures/*
